# Which dictionary the workflows read, and which ODM version they generate.
#
# This lives outside any one workflow because more than one of them needs the
# same answers: the schema generation and the rest of the dictionary rollout
# have to read the same tables from the same place, and a retargeted dictionary
# should be a one-line change here rather than the same edit made twice.
#
# Loaded by .github/actions/odm-config, which puts these into the environment
# of every later step in the job. The file is read as a dotenv file, so each
# line is NAME=VALUE with no quoting and no expansion — a value is taken
# literally, `#` starts a comment only at the start of a line.

# The major ODM version to generate by default. Also names the output
# directory, the default committed schema (schemas/odm_v<version>.yaml), and
# the dictionary tables below. A workflow_dispatch run can override this (see
# the Generate ODM Schema workflow's odm_version input) to generate an
# archival major version's schema instead -- v2.3.0's tables are ODM v2, not
# v3, so generating them needs `--version 2`, not this default.
ODM_VERSION=3

# Where the currently-published dictionary tables live: the `main` branch of
# the PHES-ODM repository, in dictionary-tables/. A workflow_dispatch run
# generating an archival version points DICTIONARY_DIR (via its
# dictionary_dir input) at that version's own folder there instead -- e.g.
# `archived V2.3 (PATCH)` for v2.3.0 -- since a superseded version's tables
# are moved out of dictionary-tables/ entirely once retired, never kept
# alongside the current ones.
DICTIONARY_REPO=PHES-ODM/PHES-ODM
DICTIONARY_DIR=dictionary-tables

# There is deliberately no PARTS_CSV/SETS_CSV setting here. PHES-ODM renames
# these files on every release (dictionary-tables/ODM_parts_v3.0.0.csv ->
# _v3.0.1.csv, etc.), so a filename fixed here would silently go stale the
# next release -- which is exactly how this repository's schema stopped
# tracking the dictionary in the first place (discovered 2026-09: this file
# still named the v3.0.0 tables while PHES-ODM had moved on to v3.0.1 two
# releases back, so every generation quietly regenerated the same stale
# v3.0.0 schema and reported no change, run after run). Instead,
# .github/actions/generate-odm-schema lists DICTIONARY_DIR at the resolved
# commit and reads whichever single ODM_parts_v*.csv/ODM_sets_v*.csv file it
# finds there -- exactly one is expected, by the same "retired versions move
# out entirely" convention above. It also deliberately does not read the
# unversioned ODM_parts.csv/ODM_sets.csv siblings PHES-ODM also publishes:
# those carry a leading `Version,X.Y.Z,...` metadata row the generator's
# plain CSV read can't handle, and (confirmed against the v2.3.0 archive)
# aren't reliably kept in sync with the versioned file's actual column set
# either -- the versioned file is the one PHES-ODM treats as the frozen,
# trustworthy snapshot.
#
# The `dictionary_ref` input of the Generate ODM Schema workflow repeats this
# value as its default, because a workflow_dispatch input default is read
# before any step runs and so cannot come from this file. Change one and change
# the other.
DICTIONARY_REF_DEFAULT=main

# The committed location of the generated schema is derived from ODM_VERSION
# as schemas/odm_v<version>.yaml, not fixed here as a single path -- an
# archival workflow_dispatch run generating v2.3.0 (ODM_VERSION overridden to
# 2) commits to schemas/odm_v2.yaml, alongside this file's odm_v3.yaml,
# rather than colliding with it.
