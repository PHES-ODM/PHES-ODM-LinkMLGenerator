# Which dictionary the workflows read, and which ODM version they generate.
#
# This lives outside any one workflow because more than one of them needs the
# same answers: the schema generation and the rest of the dictionary rollout
# have to read the same tables from the same place, and a retargeted dictionary
# should be a one-line change here rather than the same edit made twice.
#
# Loaded by .github/actions/odm-config, which puts these into the environment
# of every later step in the job. The file is read as a dotenv file, so each
# line is NAME=VALUE with no quoting and no expansion — a value is taken
# literally, `#` starts a comment only at the start of a line.

# The major ODM version to generate. Also names the output directory and the
# dictionary tables below.
ODM_VERSION=3

# Where the dictionary tables are published. The v3 tables are on the `label`
# branch of the PHES-ODM repository, in dictionary-tables/.
DICTIONARY_REPO=PHES-ODM/PHES-ODM
DICTIONARY_DIR=dictionary-tables

# The two tables the generator reads, as named in DICTIONARY_DIR.
PARTS_CSV=ODM_parts_v3.0.0.csv
SETS_CSV=ODM_sets_v3.0.0.csv

# The branch of DICTIONARY_REPO that the published dictionary lives on, and so
# the ref a run reads unless it was pointed at another one. A workflow that
# writes something back to this repository should treat a run against any other
# ref as being for inspection only: what is committed here tracks the published
# dictionary, and nothing else.
#
# The `dictionary_ref` input of the Generate ODM Schema workflow repeats this
# value as its default, because a workflow_dispatch input default is read
# before any step runs and so cannot come from this file. Change one and change
# the other.
DICTIONARY_REF_DEFAULT=label

# The committed location of the generated schema, and so the path anything
# reading the ODM v3 schema out of this repository should read. The version is
# spelled out rather than built from ODM_VERSION because this file is data, not
# shell: nothing in a value is expanded.
SCHEMA_PATH=schemas/odm_v3.yaml
